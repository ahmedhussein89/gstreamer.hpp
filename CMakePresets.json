{
    "version": 8,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/../build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC 15.2.0 x86_64-pc-linux-gnu",
            "description": "Using compilers: C = /usr/bin/gcc, CXX = /usr/bin/g++",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang 22.1.2 x86_64-pc-linux-gnu",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "asan",
            "displayName": "ASan + UBSan",
            "description": "GST_ENABLE_SANITIZERS=ON, GST_SANITIZER=address (also catches most UB)",
            "inherits": "base",
            "cacheVariables": {
                "GST_ENABLE_SANITIZERS": "ON",
                "GST_SANITIZER": "address"
            }
        },
        {
            "name": "tsan",
            "displayName": "ThreadSanitizer",
            "description": "GST_ENABLE_SANITIZERS=ON, GST_SANITIZER=thread",
            "inherits": "base",
            "cacheVariables": {
                "GST_ENABLE_SANITIZERS": "ON",
                "GST_SANITIZER": "thread"
            }
        },
        {
            "name": "tidy",
            "displayName": "clang-tidy",
            "description": "GST_ENABLE_CLANG_TIDY=ON, runs clang-tidy-22 as part of the build",
            "inherits": "clang-release",
            "cacheVariables": {
                "GST_ENABLE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "cppcheck",
            "displayName": "cppcheck",
            "description": "GST_ENABLE_CPPCHECK=ON, runs cppcheck as part of the build",
            "inherits": "base",
            "cacheVariables": {
                "GST_ENABLE_CPPCHECK": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-build",
            "configurePreset": "gcc-release"
        },
        {
            "name": "clang-build",
            "configurePreset": "clang-release"
        },
        {
            "name": "asan-build",
            "configurePreset": "asan"
        },
        {
            "name": "tsan-build",
            "configurePreset": "tsan"
        },
        {
            "name": "tidy-build",
            "configurePreset": "tidy"
        },
        {
            "name": "cppcheck-build",
            "configurePreset": "cppcheck"
        }
    ],
    "testPresets": [
        {
            "name": "gcc-tests",
            "configurePreset": "gcc-release",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "clang-tests",
            "configurePreset": "clang-release",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "asan-tests",
            "configurePreset": "asan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false },
            "environment": { "GST_DEBUG": "0" }
        },
        {
            "name": "tsan-tests",
            "configurePreset": "tsan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false },
            "environment": { "GST_DEBUG": "0" }
        }
    ],
    "workflowPresets": [
        {
            "name": "gcc-workflow",
            "steps": [
                { "type": "configure", "name": "gcc-release" },
                { "type": "build", "name": "gcc-build" },
                { "type": "test", "name": "gcc-tests" }
            ]
        },
        {
            "name": "clang-workflow",
            "steps": [
                { "type": "configure", "name": "clang-release" },
                { "type": "build", "name": "clang-build" },
                { "type": "test", "name": "clang-tests" }
            ]
        },
        {
            "name": "asan-workflow",
            "steps": [
                { "type": "configure", "name": "asan" },
                { "type": "build", "name": "asan-build" },
                { "type": "test", "name": "asan-tests" }
            ]
        },
        {
            "name": "tsan-workflow",
            "steps": [
                { "type": "configure", "name": "tsan" },
                { "type": "build", "name": "tsan-build" },
                { "type": "test", "name": "tsan-tests" }
            ]
        },
        {
            "name": "tidy-workflow",
            "steps": [
                { "type": "configure", "name": "tidy" },
                { "type": "build", "name": "tidy-build" }
            ]
        },
        {
            "name": "cppcheck-workflow",
            "steps": [
                { "type": "configure", "name": "cppcheck" },
                { "type": "build", "name": "cppcheck-build" }
            ]
        }
    ]
}
